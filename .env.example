# ═══════════════════════════════════════════════════════
# gIVEMEGAME.IO — Server Configuration
# ═══════════════════════════════════════════════════════
# 1. Skopíruj tento súbor: copy .env.example .env
# 2. Do .env vlož svoj skutočný OPENAI_API_KEY
# 3. .env.example = šablóna (placeholder), .env = tvoje hodnoty
# NEVER commit .env to version control.
# ═══════════════════════════════════════════════════════

# ─── OpenAI API ───────────────────────────────────────
# Your OpenAI API key (starts with sk-)
# Get one at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Model to use for game generation + narrator (text)
# gpt-4o         = best quality, higher cost (recommended for production)
# gpt-4o-mini    = faster, lower cost (good for development / high volume)
OPENAI_MODEL=gpt-4o

# TTS model (hlas vypraváča) — oddelený od chat modelu
# gpt-4o-mini-tts = najnovší
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# Štýl SMARTA — genz = Gen Z slang (obsah rovnaký, len iný slovník)
# NARRATOR_STYLE=genz

# Max tokens for generation response
OPENAI_MAX_TOKENS=5000

# Temperature (0.0 = deterministic, 1.0 = creative)
OPENAI_TEMPERATURE=0.8

# ─── Supabase (pre migrácie) ───────────────────────────
# Z Supabase Dashboard → Project Settings → Database → Connection string (URI)
# Session mode, napr: postgresql://postgres.[PROJECT]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
SUPABASE_DB_URL=your-supabase-connection-string-here

# ─── Supabase Auth / REST (backend verifikácia tokenov) ───
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ─── Server ───────────────────────────────────────────
# Port for the backend API server
PORT=3000

# Environment: development | production
NODE_ENV=development

# ─── Stripe subscriptions (Checkout + signed webhook) ─────────────
# The legacy STRIPE_PAYMENT_LINK_PRO_MONTHLY flow is retired. Do not configure it.
# Keep all real Stripe values only in .env.local or the deployment environment.
# Checkout stays disabled unless BILLING_SUBSCRIPTIONS_ENABLED is exactly "true"
# and every required variable below is present and valid.
BILLING_SUBSCRIPTIONS_ENABLED=false

# Stripe secret API key. Never expose this in browser code or commit it.
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_STRIPE_SECRET_KEY
# Signing secret for POST /api/billing/stripe-webhook. This is not an API key.
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_STRIPE_WEBHOOK_SIGNING_SECRET

# Two distinct recurring Stripe Price IDs used by self-service Teacher Checkout.
STRIPE_PRICE_TEACHER_MONTHLY=price_REPLACE_WITH_TEACHER_MONTHLY_PRICE_ID
STRIPE_PRICE_TEACHER_YEARLY=price_REPLACE_WITH_TEACHER_YEARLY_PRICE_ID
# Optional compatibility mapping for an externally provisioned School pilot.
# School is contact-led and is never offered by the self-service Checkout endpoint.
STRIPE_PRICE_SCHOOL_YEARLY=

# Public application origin and legal/contact pages. Production requires HTTPS.
# HTTP is accepted only for localhost in an explicit development/test runtime.
APP_ORIGIN=https://your-production-domain.example
BILLING_TERMS_URL=https://your-production-domain.example/terms
BILLING_PRIVACY_URL=https://your-production-domain.example/privacy
BILLING_CONTACT_URL=https://your-production-domain.example/contact

# Version identifiers persisted with checkout consent, plus the withdrawal-consent copy.
BILLING_TOS_VERSION=YYYY-MM-DD
BILLING_PRIVACY_VERSION=YYYY-MM-DD
BILLING_WITHDRAWAL_CONSENT_TEXT=REPLACE_WITH_APPROVED_WITHDRAWAL_CONSENT_TEXT

# Optional public support contact shown in billing UI; it is not a credential.
BILLING_SUPPORT_EMAIL=billing-support@your-production-domain.example
