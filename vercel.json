{
  "version": 2,
  "buildCommand": "npm install",
  "builds": [
    { "src": "server.js", "use": "@vercel/node", "config": { "maxDuration": 60 } }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "server.js" },
    { "src": "/(.*)", "dest": "server.js" }
  ],
  "crons": [
    { "path": "/api/cron/session-sweep", "schedule": "0 4 * * *" }
  ]
}
