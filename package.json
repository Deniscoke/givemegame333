{
  "name": "givemegame-io",
  "version": "1.0.0",
  "description": "Intelligent educational game generator",
  "main": "server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "dev:local": "node -r ./scripts/load-local-env.js server.js",
    "tunnel": "npx localtunnel --port 3000",
    "db:migrate": "node scripts/run-supabase-migrations.js",
    "db:migrate:list": "node scripts/run-supabase-migrations.js --list",
    "db:migrate:release:dry-run": "node scripts/run-supabase-migrations.js --dry-run --from 026",
    "test": "node --test",
    "test:unit": "node --test test/reward-validation.test.js",
    "test:integration": "node --test test/integration/billing.test.js test/integration/rate-limit.test.js",
    "db:local:start": "npx --yes supabase@3.2.0 start --workdir . -x edge-runtime,vector,logflare,imgproxy,supavisor",
    "db:local:stop": "npx --yes supabase@3.2.0 stop --workdir .",
    "db:local:status": "npx --yes supabase@3.2.0 status --workdir .",
    "db:local:env": "node scripts/write-local-env.js",
    "db:local:migrate": "node -r ./scripts/load-local-env.js scripts/run-supabase-migrations.js",
    "db:local:seed": "node scripts/seed-local.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "openai": "^4.82.0",
    "pg": "^8.20.0",
    "stripe": "^22.0.2"
  }
}
